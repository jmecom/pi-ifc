{
  "name": "pi-ifc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A small Pi extension for experimenting with information flow control",
  "scripts": {
    "start": "node run.mjs",
    "check": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
